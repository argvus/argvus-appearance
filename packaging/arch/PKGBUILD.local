# Maintainer: William C. Canin
pkgname=argvus-appearance
pkgver=0.1.2
pkgrel=2
pkgdesc="Shared wallpapers, fonts, themes and appearance integration for the Argvus desktop"
arch=('any')
url="https://github.com/argvus/argvus-appearance"
license=('GPL-3.0-only')
options=('!debug')
depends=(
  'argvus-session'
  'brightnessctl'
  'fontconfig'
  'gtk3'
  'gtk4'
  'hyprland'
  'hyprpaper'
  'hyprpicker'
  'imagemagick'
  'procps-ng'
  'qt6ct'
  'swaybg'
)
optdepends=(
  'argvus-app-profiles: terminal and TUI app theme integration'
  'argvus-calendar: calendar theme integration'
  'argvus-lock: Hyprlock theme integration'
  'argvus-notifications: Dunst theme integration'
  'argvus-shell: Waybar, rofi and Quickshell theme integration'
  'argvus-storage: removable storage theme integration'
  'ddcutil: external monitor brightness control'
  'rofi: interactive theme, accent and brightness menus'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=("SKIP")

package() {
  cd "${pkgname}-${pkgver}"

  make DESTDIR="${pkgdir}" PREFIX=/usr install

  install -Dm644 LICENSE \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
