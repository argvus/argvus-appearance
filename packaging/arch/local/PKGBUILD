# Maintainer: William C. Canin
pkgname=argvus-appearance
pkgver=0.2.0
pkgrel=1
pkgdesc="Shared themes and appearance integration for the Argvus desktop"
arch=('any')
url="https://github.com/argvus/argvus-appearance"
license=('GPL-3.0-only')
options=('!debug')
depends=(
  'util-linux'
  'argvus-i18n'
  'argvus-config'
  'argvus-session'
  'argvus-fonts'
  'argvus-wallpapers'
  'argvus-loading-theme'
  'brightnessctl'
  'fontconfig'
  'gtk3'
  'gtk4'
  'argvus-icons'
  'hyprland'
  'hyprpaper'
  'hyprpicker'
  'imagemagick'
  'procps-ng'
  'qt6ct'
  'swaybg'
  'nwg-look'
)
optdepends=(
  'argvus-app-profiles: TUI app wrappers and non-Kitty app theme integration'
  'argvus-terminal: Kitty terminal theme integration'
  'argvus-system-monitor: btop system monitor theme integration'
  'argvus-taskbar-calendar: calendar theme integration'
  'argvus-lock: Hyprlock theme integration'
  'argvus-notifications: Dunst theme integration'
  'argvus-control-panel: Quickshell theme integration'
  'argvus-launcher: Rofi theme integration'
  'argvus-taskbar: Waybar taskbar theme integration'
  'argvus-widget-telemetry: Waybar widget telemetry theme integration'
  'argvus-removable-devices: removable storage theme integration'
  'ddcutil: external monitor brightness control'
  'rofi: interactive theme, accent and brightness menus'
)
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=()

# shellcheck disable=SC1091
_functions_file="${startdir:-$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)}/../common/functions.sh"
. "$_functions_file"

prepare() {
  arch_normalize_source_tree
}

check() {
  arch_check_appearance_payload
}

package() {
  arch_package_appearance_payload
}
